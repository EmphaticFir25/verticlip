# Copy to .env and fill in. Never commit .env.
YOUTUBE_API_KEY=
GOOGLE_CLIENT_SECRETS=client_secret.json
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
PUBLIC_BASE=http://localhost:33214
LMSTUDIO_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=
# Only needed if LM Studio's server requires an API key. Leave empty otherwise.
LMSTUDIO_API_KEY=
# Whisper adapter (OpenAI-style endpoint). On the ZimaBoard point at the PC's LAN address.
WHISPER_URL=http://192.168.1.19:9000/v1
# Only if the adapter has ADAPTER_API_KEY set. Leave empty otherwise.
WHISPER_API_KEY=
# private | unlisted | public. Start with private until you trust the output.
YOUTUBE_PRIVACY=private
# Font for the "Verticlip" text watermark. Leave empty to use Arial Bold from C:\Windows\Fonts.
FONT_PATH=
